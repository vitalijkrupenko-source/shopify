# Neon Postgres connection string (use the pooled connection string on Vercel)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The single password used to log in to the dashboard
DASHBOARD_PASSWORD="change-me"

# Google Cloud API key with the Places API (New) enabled
GOOGLE_PLACES_API_KEY=""

# Random secret; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
# Generate one with: openssl rand -hex 32
CRON_SECRET=""
