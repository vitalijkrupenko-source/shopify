# Copy to .env (or export in your shell) — every integration is OPTIONAL.
# Without credentials the system runs fully in dry-run mode: everything works,
# outbound messages are logged to the console instead of sent.

# Where the app is reachable (used in review/unsubscribe links sent to customers)
BASE_URL=http://localhost:4000
PORT=4000

# --- Email (any SMTP provider: Postmark, SES, Mailgun, Gmail app password...) ---
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM="Joe's Pizza <reviews@joespizza.com>"

# --- SMS via Twilio -------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM=+15551234567

# --- Google Places API (optional: Place ID lookup + live review-count tracking) --
# GOOGLE_MAPS_API_KEY=AIza...

# --- Webhook auth for /api/hooks/visit (POS / Shopify enrollment) -----------------
# WEBHOOK_SECRET=change-me

# Where the JSON database lives (default: ./data)
# DATA_DIR=./data
